	"tokenColors": [
		{
			"settings": {
				"background": "#0d1016",
				"foreground": "#bfbdb6"
			}
		},
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#5c6773"
			}
		},
		{
			"name": "Documentation comments",
			"scope": [
				"comment.documentation",
				"comment.block.documentation",
				"comment.line.documentation"
			],
			"settings": {
				"foreground": "#8c8b88"
			}
		},
		{
			"name": "Keywords and storage",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": {
				"foreground": "#ff8f3f"
			}
		},
		{
			"name": "Operators",
			"scope": [
				"keyword.operator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#f29668"
			}
		},
		{
			"name": "Preprocessor",
			"scope": [
				"meta.preprocessor",
				"keyword.control.directive",
				"entity.name.function.preprocessor"
			],
			"settings": {
				"foreground": "#ff8f3f"
			}
		},
		{
			"name": "Language constants and numbers",
			"scope": [
				"constant",
				"constant.language",
				"constant.numeric",
				"support.constant",
				"variable.language"
			],
			"settings": {
				"foreground": "#d2a6ff"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.interface",
				"entity.name.struct",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#59c2ff"
			}
		},
		{
			"name": "Enums",
			"scope": [
				"entity.name.enum",
				"entity.name.type.enum"
			],
			"settings": {
				"foreground": "#fe8f40"
			}
		},
		{
			"name": "Constructors and variants",
			"scope": [
				"entity.name.function.constructor",
				"entity.name.type.variant",
				"entity.name.type.union"
			],
			"settings": {
				"foreground": "#5ac1fe"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"variable.function",
				"meta.function-call",
				"support.function.go"
			],
			"settings": {
				"foreground": "#ffb353"
			}
		},
		{
			"name": "Variables",
			"scope": [
				"variable",
				"support.variable"
			],
			"settings": {
				"foreground": "#bfbdb6"
			}
		},
		{
			"name": "Parameters",
			"scope": [
				"variable.parameter",
				"meta.parameter"
			],
			"settings": {
				"foreground": "#d2a6ff"
			}
		},
		{
			"name": "Properties and attributes",
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"meta.property-name",
				"support.type.property-name",
				"entity.other.attribute-name",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#5ac1fe"
			}
		},
		{
			"name": "Strings",
