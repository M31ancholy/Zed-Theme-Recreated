  "description": "Unofficial Zed-inspired One Light And Ayu Dark themes for VS code",
  "version": "0.0.10",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
