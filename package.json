{
  "name": "zed-theme-recreated",
  "displayName": "Zed Theme Recreated",
  "description": "Unofficial recreations of Zed's One Light and Ayu Dark themes for Visual Studio Code.",
  "version": "0.0.10",
  "repository": {
    "type": "git",
    "url": "https://github.com/M31ancholy/Zed-Theme-Recreated.git"
  },
  "homepage": "https://github.com/M31ancholy/Zed-Theme-Recreated#readme",
  "bugs": {
    "url": "https://github.com/M31ancholy/Zed-Theme-Recreated/issues"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "zed",
    "theme",
    "one light",
    "ayu",
    "light",
    "dark"
  ],
  "contributes": {
    "themes": [
      {
        "label": "zed-one-light",
        "uiTheme": "vs",
        "path": "./themes/zed-one-light.json"
      },
      {
        "label": "zed-ayu-dark",
        "uiTheme": "vs-dark",
        "path": "./themes/zed-ayu-dark.json"
      }
    ]
  }
}
